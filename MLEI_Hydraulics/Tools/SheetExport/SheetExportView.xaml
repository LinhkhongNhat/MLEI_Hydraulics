<UserControl x:Class="MLEI_Hydraulics.Tools.SheetExport.SheetExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Resources>

    <!-- Rule: shared brushes use DynamicResource in views (see ComingSoonView) -->
    <Grid IsEnabled="{Binding InputEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left: sheet list ============ -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <!-- Saved sheet sets: pick one to tick its sheets, or type a name and press Save set -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Sheet set" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="Delete" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding DeleteSetCommand}"
                        ToolTip="Delete the saved set named in the box"/>
                <Button DockPanel.Dock="Right" Content="Save set" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding SaveSetCommand}"
                        ToolTip="Save the ticked sheets under the name in the box"/>
                <ComboBox IsEditable="True"
                          IsTextSearchEnabled="False"
                          ItemsSource="{Binding SheetSets}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedSet}"
                          Text="{Binding SetName, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Pick a saved set to tick its sheets, (none) to untick everything, or type a new name and press Save set"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Select none" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding SelectNoneCommand}"/>
                <Button DockPanel.Dock="Right" Content="Select all" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding SelectAllCommand}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="4,3"
                         ToolTip="Type words in the order they appear in the sheet number or name, e.g. drainage zone 10"/>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Margin="2,6,0,0"
                       Text="{Binding SelectionText}"
                       Foreground="{DynamicResource MutedTextBrush}"/>

            <DataGrid ItemsSource="{Binding SheetsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      Background="White"
                      BorderBrush="#DDDDDD">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                <Setter Property="Foreground" Value="#C62828"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sheet number" Width="110"
                                        Binding="{Binding SheetNumber, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Sheet name" Width="*"
                                        Binding="{Binding SheetName, Mode=OneWay}"/>
                    <DataGridTextColumn Header="File name" Width="1.2*"
                                        Binding="{Binding FileNameDisplay, Mode=OneWay}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ============ Right: options ============ -->
        <!-- The grid inside the scroll viewer fills the available height: the parts table (the * row)
             grows when the window gets taller, and the "add" controls stay at the bottom. -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Format -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Format" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="PDF" GroupName="Format" IsChecked="{Binding IsPdf}" Margin="0,0,24,0"/>
                        <RadioButton Content="DWG" GroupName="Format" IsChecked="{Binding IsDwg}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsDwg, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DWG export setup" Style="{StaticResource SectionTitle}"/>
                        <ComboBox ItemsSource="{Binding DwgSetups}" SelectedItem="{Binding SelectedDwgSetup}"/>
                        <CheckBox Content="Export views on sheets into one file (no external references)"
                                  IsChecked="{Binding MergeViews}" Margin="0,8,0,0">
                            <CheckBox.ToolTip>Turn this off to keep each view as a separate xref file, as set in the chosen setup.</CheckBox.ToolTip>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>

                <!-- Output folder -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Output folder" Style="{StaticResource SectionTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,3" Margin="6,0,0,0"
                                Click="Browse_Click"/>
                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="4,3"/>
                    </DockPanel>
                </StackPanel>

                <!-- File name: text for the very start and end of the name -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="File name" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prefix (start of the whole name)" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Suffix (end of the whole name)" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Name parts: grows with the window -->
                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Name parts, in order" Margin="0,0,0,2"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Prefix and suffix are added around each value. Use the suffix for separators such as -. A part with no value is left out with its prefix and suffix. A separator left at the very end is dropped."/>

                    <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" Width="80">
                        <Button Content="Up" Padding="8,2" Margin="0,0,0,4" Command="{Binding MoveUpCommand}"/>
                        <Button Content="Down" Padding="8,2" Margin="0,0,0,4" Command="{Binding MoveDownCommand}"/>
                        <Button Content="Remove" Padding="8,2" Command="{Binding RemovePartCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Parts}"
                              SelectedItem="{Binding SelectedPart}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              Background="White"
                              BorderBrush="#DDDDDD">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Part" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" ToolTip="{Binding Display}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="2,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Prefix" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                                 GotKeyboardFocus="PartBox_GotKeyboardFocus"
                                                 BorderBrush="#E0E0E0" Padding="2,1" Margin="1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Suffix" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                                 GotKeyboardFocus="PartBox_GotKeyboardFocus"
                                                 BorderBrush="#E0E0E0" Padding="2,1" Margin="1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Add controls: stuck to the bottom of the panel -->
                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock Text="Add a sheet or project parameter" Margin="0,4,0,2"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add" Padding="10,3" Margin="6,0,0,0" MinWidth="64"
                                Command="{Binding AddFieldCommand}"/>
                        <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding SelectedField}"/>
                    </DockPanel>

                    <TextBlock Text="Add fixed text" Margin="0,10,0,2"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add text" Padding="10,3" Margin="6,0,0,0" MinWidth="64"
                                Command="{Binding AddTextCommand}"/>
                        <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                    </DockPanel>

                    <CheckBox Content="Overwrite files that already exist" IsChecked="{Binding Overwrite}" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============ Bottom bar ============ -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <ProgressBar Height="6" Minimum="0"
                             Maximum="{Binding ProgressMax, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Open folder" Padding="14,8" Margin="0,0,8,0"
                    Command="{Binding OpenFolderCommand}"/>
            <Button Grid.Column="2" Content="Export" Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding ExportCommand}"/>
        </Grid>
    </Grid>
</UserControl>
