<UserControl x:Class="MLEI_Hydraulics.Tools.SheetExport.SheetExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Resources>

    <!-- Rule: shared brushes use DynamicResource in views (see ComingSoonView) -->
    <Grid IsEnabled="{Binding InputEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left: sheet list ============ -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Select none" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding SelectNoneCommand}"/>
                <Button DockPanel.Dock="Right" Content="Select all" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding SelectAllCommand}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="4,3"
                         ToolTip="Filter by sheet number or name"/>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Margin="2,6,0,0"
                       Text="{Binding SelectionText}"
                       Foreground="{DynamicResource MutedTextBrush}"/>

            <DataGrid ItemsSource="{Binding SheetsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      Background="White"
                      BorderBrush="#DDDDDD">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                <Setter Property="Foreground" Value="#C62828"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sheet number" Width="110"
                                        Binding="{Binding SheetNumber, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Sheet name" Width="*"
                                        Binding="{Binding SheetName, Mode=OneWay}"/>
                    <DataGridTextColumn Header="File name" Width="1.2*"
                                        Binding="{Binding FileNameDisplay, Mode=OneWay}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ============ Right: options ============ -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <TextBlock Text="Format" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="PDF" GroupName="Format" IsChecked="{Binding IsPdf}" Margin="0,0,24,0"/>
                    <RadioButton Content="DWG" GroupName="Format" IsChecked="{Binding IsDwg}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsDwg, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="DWG export setup" Style="{StaticResource SectionTitle}"/>
                    <ComboBox ItemsSource="{Binding DwgSetups}" SelectedItem="{Binding SelectedDwgSetup}"/>
                    <CheckBox Content="Export views on sheets into one file (no external references)"
                              IsChecked="{Binding MergeViews}" Margin="0,8,0,0">
                        <CheckBox.ToolTip>Turn this off to keep each view as a separate xref file, as set in the chosen setup.</CheckBox.ToolTip>
                    </CheckBox>
                </StackPanel>

                <TextBlock Text="Output folder" Style="{StaticResource SectionTitle}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,3" Margin="6,0,0,0"
                            Click="Browse_Click"/>
                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="4,3"/>
                </DockPanel>

                <!-- ===== File name: prefix + ordered parts + suffix ===== -->
                <TextBlock Text="File name" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Prefix" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Suffix" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Name parts, joined in this order" Margin="0,10,0,2"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" Width="64">
                        <Button Content="Up" Padding="8,2" Margin="0,0,0,4" Command="{Binding MoveUpCommand}"/>
                        <Button Content="Down" Padding="8,2" Margin="0,0,0,4" Command="{Binding MoveDownCommand}"/>
                        <Button Content="Remove" Padding="8,2" Command="{Binding RemovePartCommand}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Parts}"
                             SelectedItem="{Binding SelectedPart}"
                             DisplayMemberPath="Display"
                             Height="120"
                             BorderBrush="#DDDDDD"/>
                </DockPanel>

                <TextBlock Text="Add a sheet, title block or project parameter" Margin="0,10,0,2"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add" Padding="10,3" Margin="6,0,0,0" MinWidth="64"
                            Command="{Binding AddFieldCommand}"/>
                    <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding SelectedField}"/>
                </DockPanel>

                <TextBlock Text="Add fixed text" Margin="0,10,0,2"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add text" Padding="10,3" Margin="6,0,0,0" MinWidth="64"
                            Command="{Binding AddTextCommand}"/>
                    <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                </DockPanel>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Separator between parts" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBox Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" Width="80"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <CheckBox Content="Overwrite files that already exist" IsChecked="{Binding Overwrite}" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Bottom bar ============ -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <ProgressBar Height="6" Minimum="0"
                             Maximum="{Binding ProgressMax, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Open folder" Padding="14,8" Margin="0,0,8,0"
                    Command="{Binding OpenFolderCommand}"/>
            <Button Grid.Column="2" Content="Export" Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding ExportCommand}"/>
        </Grid>
    </Grid>
</UserControl>
