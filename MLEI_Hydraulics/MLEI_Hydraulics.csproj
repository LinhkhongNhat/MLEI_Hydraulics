<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PlatformTarget>x64</PlatformTarget>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<RootNamespace>MLEI_Hydraulics</RootNamespace>
		<AssemblyName>MLEI_Hydraulics</AssemblyName>

		<!-- Keep the output in bin\Debug\ so your current .addin still finds the DLL -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- Keep using your existing Properties\AssemblyInfo.cs -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<!-- Same language behaviour as before -->
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>

		<!-- Revit 2025/2026 run on .NET 8, which newer SDKs flag as out of support -->
		<CheckEolTargetFramework>false</CheckEolTargetFramework>

		<!-- Which Revit API to compile against (used again in step 4b) -->
		<RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
	</ItemGroup>

	<!-- Images are compiled into the DLL (needed for the pack:// icon addresses) -->
	<ItemGroup>
		<None Remove="Resources\*.png" />
		<Resource Include="Resources\*.png" />
	</ItemGroup>

	<!-- Debug builds: automatically copy the DLL to the installed location so Revit
	     picks up your latest code without touching the .addin file or the installer.
	     Release builds are left alone — they are handled by the CI installer pipeline. -->
	<Target Name="DeployDebug" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Message Text="Deploying debug build → %LOCALAPPDATA%\MLEI_Hydraulics\$(RevitVersion)\" Importance="high" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
		      DestinationFolder="$(LocalAppData)\MLEI_Hydraulics\$(RevitVersion)"
		      OverwriteReadOnlyFiles="true" />
	</Target>

</Project>
